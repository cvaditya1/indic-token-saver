# Empty on purpose. Copy to .env and fill keys locally. .env is gitignored.
# Do not commit keys.

GEMINI_API_KEY=
GROQ_API_KEY=

# Published-price FX assumption. Verify before quoting a rupee figure.
# See SPEC.md. Free-tier actual bill is INR 0.
USD_INR_RATE=96.64

LOG_PATH=logs/requests.jsonl
CACHE_PATH=data/translation_cache.sqlite
DEFAULT_PROVIDER=gemini

# Confirm these ids are still on the free tier before use.
DEFAULT_GEMINI_MODEL=gemini-3.5-flash-lite
DEFAULT_GROQ_MODEL=openai/gpt-oss-20b

# 1 adds prompt_sha256 to the log. The raw prompt is never stored.
LOG_PROMPT_HASH=0
